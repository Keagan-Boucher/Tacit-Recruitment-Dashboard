{
  "name": "tacit",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "shared"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k -n web,server -c green,blue \"npm run dev -w web\" \"npm run dev -w server\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "npm run test --workspaces --if-present && node --import tsx --test \"scripts/**/*.test.mjs\" \"scripts/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run check:tokens && npm test",
    "snap": "node --env-file-if-exists=.env.snap .claude/skills/tacit-build/scripts/snap-screens.mjs",
    "test:rules": "npx -y firebase-tools@13.35.1 emulators:exec --only firestore,storage --project tacit-3cdd4 \"npx vitest run --config tests/rules/vitest.config.ts\"",
    "set-role": "node --env-file-if-exists=.env.snap --import tsx scripts/set-role.ts",
    "seed": "node --env-file-if-exists=.env.snap --import tsx scripts/seed-synthetic.ts",
    "eval": "node --env-file-if-exists=server/.env --import tsx evals/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
