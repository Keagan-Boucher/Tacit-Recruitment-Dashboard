{
  "name": "tacit",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,server -c green,blue \"npm run dev -w web\" \"npm run dev -w server\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "npm run test --workspaces --if-present && node --test \"scripts/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run check:tokens && npm test",
    "snap": "node --env-file-if-exists=.env.snap .claude/skills/tacit-build/scripts/snap-screens.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
