rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function recruiter() { return role() == 'recruiter'; }
    // owns() is recruiter-only: portal users never match a recruiter's ownerUid, even if it equals their uid.
    function owns(data) { return recruiter() && data.ownerUid == request.auth.uid; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Normal owner CRUD. Create must carry the caller's uid; update can't hand the doc to someone else.
    match /{col}/{id} {
      allow read, delete: if col in ['candidates', 'interviewNotes', 'companies', 'roles', 'questionGuides', 'placements']
        && owns(resource.data);
      allow create: if col in ['candidates', 'interviewNotes', 'companies', 'roles', 'questionGuides', 'placements']
        && owns(request.resource.data);
      allow update: if col in ['candidates', 'interviewNotes', 'companies', 'roles', 'questionGuides', 'placements']
        && owns(resource.data) && owns(request.resource.data);
    }

    // AI-derived: proxy (Admin SDK) writes only. Client may only record a confirmation or an edit.
    match /attributes/{id} {
      allow read: if owns(resource.data);
      // S06 "Anything new?": the recruiter's own words (salary, availability) heard today, tied to an override.
      allow create: if owns(request.resource.data)
        && request.resource.data.sourceType == 'override'
        && request.resource.data.type in ['salary', 'availability']
        && request.resource.data.overrideId is string
        && request.resource.data.confirmedByRecruiter == true;
      allow update: if owns(resource.data)
        && onlyChanges(['confirmedByRecruiter', 'editedValue', 'updatedAt'])
        && request.resource.data.confirmedByRecruiter is bool
        && request.resource.data.get('editedValue', '') is string;
    }
    match /matches/{id} {
      allow read: if owns(resource.data);
    }

    // Create-only; reversing is the single later update; never deleted.
    match /overrides/{id} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data) && request.resource.data.get('reversedAt', null) == null;
      // Reversal is one-way: set once, never cleared or rewritten.
      allow update: if owns(resource.data) && onlyChanges(['reversedAt', 'updatedAt'])
        && resource.data.get('reversedAt', null) == null
        && request.resource.data.reversedAt is timestamp;
    }

    // Any role (portal users have a theme too).
    match /userPrefs/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }

    // Portal collections: the proxy (Admin SDK) writes; clients only read their own side.
    match /portalUsers/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || owns(resource.data));
    }
    match /submissions/{id} {
      allow read: if signedIn() && (resource.data.submittedBy == request.auth.uid || owns(resource.data));
    }
    match /shortlistEntries/{id} {
      allow read: if owns(resource.data)
        || (role() == 'company' && resource.data.companyId == request.auth.token.get('companyId', null));
    }
    match /candidateUpdates/{id} {
      allow read: if signedIn() && (resource.data.portalUid == request.auth.uid || owns(resource.data));
    }
    match /courseSuggestions/{cid} {
      allow read: if owns(resource.data)
        || (role() == 'candidate' && cid == request.auth.token.get('candidateId', null)
            && resource.data.status in ['approved', 'snoozed']);
      // Candidate may only snooze or dismiss; drafting and approval go through the proxy.
      allow update: if role() == 'candidate' && cid == request.auth.token.get('candidateId', null)
        && resource.data.status in ['approved', 'snoozed']
        && onlyChanges(['status', 'snoozedUntil', 'updatedAt'])
        && request.resource.data.status in ['snoozed', 'dismissed']
        && request.resource.data.get('snoozedUntil', request.time) is timestamp;
    }
    match /invites/{id} {
      allow read, delete: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }
  }
}
