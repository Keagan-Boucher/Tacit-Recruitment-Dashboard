# Copy to functions/.env.tacit-3cdd4 (git-ignored) and fill in. AI_API_KEY is NOT here: it lives in Secret Manager.
# The web origin allowed by CORS (the Hostinger domain)
ALLOWED_ORIGIN=https://tacit.keaganboucher.com
# Any OpenAI-compatible endpoint
AI_BASE_URL=https://api.groq.com/openai/v1
# Model id sent to that endpoint
AI_MODEL=openai/gpt-oss-120b
# Storage bucket (named STORAGE_BUCKET: Functions reserves the FIREBASE_ prefix) for uploaded CVs and briefs, e.g. tacit-3cdd4.firebasestorage.app
STORAGE_BUCKET=
# The recruiter's uid; every portal record is owned by it (required)
RECRUITER_UID=
# Optional comma-separated uids allowed the recruiter role (empty = no extra filter)
ALLOWED_UIDS=
