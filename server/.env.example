AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
PORT=8787
FIREBASE_SERVICE_ACCOUNT_PATH=
ALLOWED_ORIGIN=

# Storage bucket for uploaded CVs/briefs (same as web VITE_FIREBASE_STORAGE_BUCKET)
FIREBASE_STORAGE_BUCKET=

# Optional extra filter: comma-separated uids allowed to use the recruiter role (empty = no extra filter). Never applies to candidates or companies.
ALLOWED_UIDS=

# The recruiter's uid. Every portal record (portalUsers, submissions) is stamped ownerUid = this. Required.
RECRUITER_UID=
